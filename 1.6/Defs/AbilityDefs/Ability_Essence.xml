<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ============================= -->
		<!-- ESSENCE OF HERESY -->
	<!-- ============================= -->
	
	<AbilityDef Name="EssenceBase">
		<defName>domom_RuinBlast</defName>
		<label>hungering gaze</label>
		<description>Fire a burst of low-accuracy energy motes that will detonate after a short delay.</description>
		<iconPath>UI/Abilities/HungeringGaze</iconPath>
		<writeCombatLog>True</writeCombatLog>
		<showPsycastEffects>False</showPsycastEffects>
		<cooldownTicksRange>2500</cooldownTicksRange>
		<verbProperties>
			<verbClass>Verb_LaunchProjectileHeresy</verbClass>
			<defaultProjectile>domom_Bullet_VisionsOfHeresy</defaultProjectile>
			<range>19.8</range>
			<soundCast>domom_VisionsOfHeresy_Fire</soundCast>
			<!-- <muzzleFlashScale>9</muzzleFlashScale> -->
			<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
			<warmupTime>0.5</warmupTime>
			<burstShotCount>12</burstShotCount>
			<accuracyTouch>0.65</accuracyTouch>
			<accuracyShort>0.6</accuracyShort>
			<accuracyMedium>0.55</accuracyMedium>
			<accuracyLong>0.5</accuracyLong>
			<defaultCooldownTime>1.0</defaultCooldownTime>
			<ai_IsWeapon>false</ai_IsWeapon>
		</verbProperties>
		<comps>
			<li>
				<compClass>CompAbilityEffect_HeresyHideGizmo</compClass>
			</li>
		</comps>
	</AbilityDef>
	
	<AbilityDef ParentName="EssenceBase">
		<defName>domom_RuinBlast_Enhanced</defName>
		<label>hungering gaze II</label>
		<cooldownTicksRange>5000</cooldownTicksRange>
		<verbProperties>
			<burstShotCount>24</burstShotCount>
		</verbProperties>
	</AbilityDef>

</Defs>