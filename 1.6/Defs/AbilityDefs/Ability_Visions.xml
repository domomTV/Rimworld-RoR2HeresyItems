<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ============================= -->
		<!-- VISIONS OF HERESY -->
	<!-- ============================= -->
	
	<AbilityDef Name="VisionsBase">
		<defName>domom_VisionsOfHeresy</defName>
		<label>hungering gaze</label>
		<description>Fire a burst of low-accuracy energy motes that will detonate after a short delay.</description>
		<iconPath>UI/Abilities/HungeringGaze</iconPath>
		<writeCombatLog>True</writeCombatLog>
		<showPsycastEffects>False</showPsycastEffects>
		<cooldownTicksRange>2500</cooldownTicksRange>
		<verbProperties>
			<verbClass>Verb_LaunchProjectileHeresy</verbClass>
			<defaultProjectile>domom_Bullet_VisionsOfHeresy</defaultProjectile>
			<range>19.8</range>
			<soundCast>domom_VisionsOfHeresy_Fire</soundCast>
			<!-- <muzzleFlashScale>9</muzzleFlashScale> -->
			<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
			<warmupTime>0.5</warmupTime>
			<burstShotCount>12</burstShotCount>
			<accuracyTouch>0.65</accuracyTouch>
			<accuracyShort>0.6</accuracyShort>
			<accuracyMedium>0.55</accuracyMedium>
			<accuracyLong>0.5</accuracyLong>
			<defaultCooldownTime>1.0</defaultCooldownTime>
			<ai_IsWeapon>false</ai_IsWeapon>
		</verbProperties>
		<comps>
			<li>
				<compClass>CompAbilityEffect_HeresyHideGizmo</compClass>
			</li>
		</comps>
	</AbilityDef>
	
	<AbilityDef ParentName="VisionsBase">
		<defName>domom_VisionsOfHeresy_Enhanced</defName>
		<label>hungering gaze II</label>
		<cooldownTicksRange>5000</cooldownTicksRange>
		<verbProperties>
			<burstShotCount>24</burstShotCount>
		</verbProperties>
	</AbilityDef>
	
	<ThingDef ParentName="BaseBullet">
		<defName>domom_Bullet_VisionsOfHeresy</defName>
		<thingClass>Projectile_HungeringShard</thingClass>
		<label>hungering shard</label>
		<graphicData>
			<texPath>Things/Projectile/Bullet_HungeringShard</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<projectile>
			<damageDef>domom_HungeringShard</damageDef>
			<damageAmountBase>1</damageAmountBase>
			<speed>25</speed>
		</projectile>
	</ThingDef>
	
	<ThingDef>
		<defName>domom_HungeringShard</defName>
		<label>shard mote</label>
		<thingClass>HungeringShard</thingClass>
		<category>Attachment</category>
		<tickerType>Normal</tickerType>
		<forceDebugSpawnable>true</forceDebugSpawnable>
		<!-- <canInteractThroughCorners>true</canInteractThroughCorners> -->
		<graphicData>
			<texPath>Things/Special/ShardMote/HungeringShardMote</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<drawSize>0.6</drawSize>
		</graphicData> 
		<altitudeLayer>PawnState</altitudeLayer>
		<useHitPoints>false</useHitPoints>
		<comps>
			<li Class="CompProperties_HungeringShard">
				<damageType>domom_ShardExplode</damageType>
				<damageAmountBase>5</damageAmountBase>
				<ticksUntilDetonation>120</ticksUntilDetonation>
			</li>
		</comps>
	</ThingDef>

</Defs>