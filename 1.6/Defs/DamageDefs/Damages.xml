			<li>
				<hediff>domom_Rooted_Enhanced</hediff>
			</li>
		</additionalHediffs>
	</DamageDef>
	
	<DamageDef ParentName="Arrow">
		<defName>domom_Ruin</defName>
		<label>ruin</label>
		<defaultDamage>5</defaultDamage>
		<defaultArmorPenetration>1.0</defaultArmorPenetration>
		<defaultStoppingPower>1.0</defaultStoppingPower>
		<deathMessage>{0} has been reduced to ruins.</deathMessage>
		<hediff>Stab</hediff>
	</DamageDef>
	
