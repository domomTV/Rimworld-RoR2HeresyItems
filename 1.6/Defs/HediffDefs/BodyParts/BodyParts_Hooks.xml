	<ThingDef ParentName="BodyPartHeresyBase">
		<defName>domom_HooksOfHeresy</defName>
		<label>hooks of heresy</label>
		<description>An organic arm replacement with a terrible blade at it's end. It is capable of cutting through reality itself, spawning a singularity that will lacerate anything nearby. The lack of a hand or fingers makes general manipulation much harder.</description>
		<descriptionHyperlinks><RecipeDef>domom_InstallHooksOfHeresy</RecipeDef></descriptionHyperlinks>
		<thingSetMakerTags><li>RewardStandardMidFreq</li></thingSetMakerTags>
		<statBases>
			<Mass>6</Mass>
			<MarketValue>520</MarketValue>
		</statBases>
