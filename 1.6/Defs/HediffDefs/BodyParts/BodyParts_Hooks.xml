	<HediffDef ParentName="AddedBodyPartBase">
		<defName>domom_HooksOfHeresy</defName>
		<label>heretic's hook</label>
		<labelNoun>a heretic's hook</labelNoun>
		<description>An organic arm replacement with a terrible blade at it's end. It is capable of cutting through reality itself, spawning a singularity that will lacerate anything nearby. The lack of a hand or fingers makes general manipulation impossible.</description>
		<descriptionHyperlinks><ThingDef>domom_HooksOfHeresy</ThingDef></descriptionHyperlinks>
		<comps>
			<li Class="HediffCompProperties_VerbGiver">
				<tools>
					<!-- equivalent to flesh whip -->
					<li>
						<label>blade</label> 
						<capacities>
							<li>Cut</li>
						</capacities>
						<armorPenetration>0.6</armorPenetration>
						<power>20.5</power> <!-- 2.5x natural fist -->
						<cooldownTime>2</cooldownTime>
					</li>
					<li>
						<label>hook</label> 
						<capacities>
							<li>Stab</li>
						</capacities>
						<armorPenetration>0.6</armorPenetration>
						<power>20.5</power> <!-- 2.5x natural fist -->
						<cooldownTime>2</cooldownTime>
					</li>
				</tools>
			</li>
			<li Class="HediffCompProperties_HeresyEnhanceAbility">
				<baseDef>domom_HooksOfHeresy</baseDef>
				<enhancedDef>domom_HooksOfHeresy_Enhanced</enhancedDef>
			</li>
		</comps>
		<spawnThingOnRemoved>domom_HooksOfHeresy</spawnThingOnRemoved>
		<abilities>
			<li>domom_HooksOfHeresy</li>
		</abilities>
		<addedPartProps>
			<solid>true</solid>
			<partEfficiency>0</partEfficiency>
			<betterThanNatural>false</betterThanNatural>
		</addedPartProps>
		<stages>
			<li>
				<statOffsets>
					<!-- Nullifies manipulation penalty -->
					<MeleeHitChance>6</MeleeHitChance>
				</statOffsets>
				<statFactors>
					<!-- Slight benefit at 1 hook, no effect at 2 hooks (disabled) -->
					<ButcheryFleshEfficiency>2</ButcheryFleshEfficiency>
					<!-- Nullifies penalty at 1 hook, no effect at 2 hooks (disabled) -->
					<ButcheryFleshSpeed>2</ButcheryFleshSpeed>
				</statFactors>
				<!-- 
					Possible stats to offset:
						Mechanoid Shredding Speed
						Plant Harvest Yield 
