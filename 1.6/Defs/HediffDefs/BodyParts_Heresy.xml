<Defs>

	<!-- Base Heresy Body Part -->
	
	<ThingDef Name="BodyPartHeresyBase" ParentName="BodyPartBase" Abstract="True">
		<graphicData>
			<texPath>Things/Item/Health/HealthItem</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.80</drawSize>
			<color>(118,140,189)</color>
		</graphicData>
		<tradeTags>
			<li>domom_Heresy</li>
		</tradeTags>
		<statBases>
			<WorkToMake>15000</WorkToMake>
		</statBases>
	</ThingDef>

	<ThingDef ParentName="UnfinishedBase">
		<defName>UnfinishedHealthItemHeresy</defName>
		<label>unfinished prosthetic</label>
		<description>An unfinished prosthetic.</description>
		<statBases>
			<Flammability>0.5</Flammability>
		</statBases>
		<graphicData>
			<texPath>Things/Item/Unfinished/UnfinishedHealthItem</texPath>
			<graphicClass>Graphic_Single</graphicClass>
