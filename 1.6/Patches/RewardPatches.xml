<?xml version="1.0" encoding="utf-8"?>
<Patch>
	
	<Operation Class="PatchOperationFindMod">
		<mods><li>Odyssey</li></mods>
		<match Class="PatchOperationInsert">
			<xpath>Defs/ThingSetMakerDef[defName="MapGen_HighValueCrate"]/root/options/li/thingSetMaker/fixedParams/filter/thingDefs/li[text()="ArchotechArm"]</xpath>
			<value>	
				<li>domom_VisionsOfHeresy</li>
				<li>domom_HooksOfHeresy</li>
				<li>domom_StridesOfHeresy</li>
				<li>domom_EssenceOfHeresy</li>
			</value>
		</match>
	</Operation>
	
	<Operation Class="PatchOperationFindMod">
		<mods><li>Anomaly</li></mods>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingSetMakerDef[defName="MapGen_FleshSackLoot"]/root/options</xpath>
			<value>
				<li>
					<weight>1.0</weight> <!-- essentially .25 weight per thing -->
					<thingSetMaker Class="ThingSetMaker_StackCount">
						<fixedParams>
							<filter>
								<thingDefs>
									<li>domom_VisionsOfHeresy</li>
									<li>domom_HooksOfHeresy</li>
									<li>domom_StridesOfHeresy</li>
									<li>domom_EssenceOfHeresy</li>
								</thingDefs>
							</filter>
							<countRange>1</countRange>
						</fixedParams>
					</thingSetMaker>
				</li>
			</value>
		</match>
	</Operation>
	
</Patch>